<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1B1F1C" Background="#F4F6F4">
    <!-- Копия pyRevit SelectFromList.xaml в стиле XYZ: имена элементов и обработчики не менять -->
    <Window.Resources>
        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"><ContentPresenter/></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Canvas x:Key="filterIcon">
            <Path Canvas.Top="-14" Canvas.Left="-14"
                  Data="F1 M 45.4403,56.9637L 45.4403,55.0463L 52.8201,44.5143L 52.8201,44.4237L 46.13,44.4237L 46.13,41.4774L 57.372,41.4774L 57.372,43.5352L 50.1532,53.9265L 50.1532,54.0174L 57.4869,54.0174L 57.4869,56.9637L 45.4403,56.9637 Z M 34.8333,61.75L 34.8333,42.75L 19,20.5833L 57,20.5833L 41.1667,42.75L 41.1667,58.5833L 34.8333,61.75 Z M 25.903,52.8055L 21.4072,52.8055L 20.289,56.9855L 16.6085,56.9855L 21.4072,41.4556L 26.0661,41.4556L 30.9337,56.9855L 27.1143,56.9855L 25.903,52.8055 Z M 21.9196,50.2801L 25.3905,50.2801L 24.4122,46.9804L 23.9987,45.4806L 23.6201,43.981L 23.5736,43.981L 23.2212,45.4941L 22.8514,47.0194L 21.9196,50.2801 Z "
                  Fill="#2E7D32">
                <Path.LayoutTransform>
                    <ScaleTransform ScaleX="0.36"  ScaleY="0.36"/>
                </Path.LayoutTransform>
            </Path>
        </Canvas>

        <ControlTemplate x:Key="ItemTemplate">
            <TextBlock Text="{Binding name}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
        </ControlTemplate>

        <DataTemplate x:Key="ItemContainerTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding checked}"
                          Checked="check_selected"
                          Unchecked="uncheck_selected"
                          Visibility="{Binding checkable}"/>
                <Control Grid.Column="1"
                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Template="{DynamicResource ItemTemplate}"/>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="ItemsPanelTemplate">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- шапка -->
        <Border DockPanel.Dock="Top" Background="#1E2A22" Padding="18,12">
            <StackPanel>
                <TextBlock x:Name="xyz_title" Foreground="White" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="xyz_sub" Foreground="#A5D6A7" FontSize="11" Margin="0,2,0,0"
                           Text="Поиск — просто начни печатать"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="14,12,14,14">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <DockPanel>
                    <ToggleButton x:Name="regexToggle_b"
                                  ToolTip="{DynamicResource SelectFromList.RegexToggle.Tooltip}"
                                  Content="{StaticResource filterIcon}" Width="30" Height="30" Margin="0,0,8,0" Click="toggle_regex" />
                    <Grid>
                        <TextBox x:Name="search_tb" Height="30" Padding="8,0,28,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="clrsearch_b" Visibility="Collapsed" Margin="0,0,6,0"
                                Width="20" Height="20" HorizontalAlignment="Right"
                                Style="{StaticResource ClearButton}" Click="clear_search" Cursor="Hand">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                  Fill="#7A847C" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </Grid>
                </DockPanel>
                <DockPanel x:Name="ctx_groups_dock" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ctx_groups_title_tb" Margin="0,4,10,0" DockPanel.Dock="Left"
                               Foreground="#7A847C"
                               Text="{DynamicResource SelectFromList.GroupSelector.Label}" />
                    <ComboBox x:Name="ctx_groups_selector_cb" Height="28"/>
                </DockPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom">
                <Grid x:Name="checkboxbuttons_g">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="checkall_b" Grid.Column="0"
                            Content="{DynamicResource SelectFromList.CheckAll.Button}"
                            Click="check_all" Margin="0,10,4,0" />
                    <Button x:Name="uncheckall_b" Grid.Column="1"
                            Content="{DynamicResource SelectFromList.UncheckAll.Button}"
                            Click="uncheck_all" Margin="2,10,2,0" />
                    <Button x:Name="toggleall_b" Grid.Column="2"
                            Content="{DynamicResource SelectFromList.ToggleAll.Button}"
                            Click="toggle_all" Margin="4,10,0,0" />
                    <Button x:Name="reset_b" Width="100" Grid.Column="3" Visibility="Collapsed"
                            Content="{DynamicResource SelectFromList.Reset.Button}"
                            Click="button_reset" Margin="4,10,0,0"/>
                </Grid>
                <Button x:Name="select_b" Height="38" Click="button_select" Margin="0,12,0,0" IsDefault="True"
                        Content="{DynamicResource SelectFromList.Select.Button}" />
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="50" />
                    <ColumnDefinition x:Name="splitterCol" Width="Auto" />
                    <ColumnDefinition x:Name="infoCol" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3DE" BorderThickness="1" CornerRadius="10" Padding="3">
                    <ListView x:Name="list_lb"
                              BorderThickness="0" Background="Transparent"
                              MouseDoubleClick="button_select"
                              SelectionChanged="selected_item_changed"
                              SelectionMode="Extended"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ItemTemplate="{DynamicResource ItemContainerTemplate}"
                              ItemsPanel="{DynamicResource ItemsPanelTemplate}"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Standard"
                              ScrollViewer.CanContentScroll="True"/>
                </Border>
                <GridSplitter x:Name="infoSplitter" Grid.Column="1" Width="6" Background="Transparent"
                              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeDirection="Columns" Visibility="Collapsed" />
                <ScrollViewer x:Name="infoPanel" Grid.Column="2" Visibility="Collapsed">
                    <TextBlock x:Name="infoData" Margin="10,0,0,0" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
