<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Единый стиль XYZ.extension: чёрный — зелёный — белый -->
  <SolidColorBrush x:Key="Xyz.Dark" Color="#1E2A22"/>
  <SolidColorBrush x:Key="Xyz.Green" Color="#2E7D32"/>
  <SolidColorBrush x:Key="Xyz.GreenHover" Color="#388E3C"/>
  <SolidColorBrush x:Key="Xyz.GreenPressed" Color="#1B5E20"/>
  <SolidColorBrush x:Key="Xyz.GreenLight" Color="#E8F5E9"/>
  <SolidColorBrush x:Key="Xyz.GreenSoft" Color="#A5D6A7"/>
  <SolidColorBrush x:Key="Xyz.Bg" Color="#F4F6F4"/>
  <SolidColorBrush x:Key="Xyz.Line" Color="#DDE3DE"/>
  <SolidColorBrush x:Key="Xyz.Ink" Color="#1B1F1C"/>
  <SolidColorBrush x:Key="Xyz.Mute" Color="#7A847C"/>

  <!-- Кнопка: белая пилюля; IsDefault=True — зелёная основная -->
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#1B1F1C"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#D5DBD6"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsDefault" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="#E8F5E9"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#2E7D32"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsDefault" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="#388E3C"/>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="#C8E6C9"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsPressed" Value="True"/>
                <Condition Property="IsDefault" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="b" Property="Background" Value="#1B5E20"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsDefault" Value="True">
        <Setter Property="Background" Value="#2E7D32"/>
        <Setter Property="BorderBrush" Value="#2E7D32"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Явная зелёная кнопка (Style="{StaticResource Xyz.Primary}") -->
  <Style x:Key="Xyz.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#2E7D32"/>
    <Setter Property="BorderBrush" Value="#2E7D32"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style TargetType="ToggleButton">
    <Setter Property="Foreground" Value="#1B1F1C"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="BorderBrush" Value="#D5DBD6"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="#A5D6A7"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#2E7D32"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="#2E7D32"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Поле ввода: скруглённое, зелёная рамка в фокусе -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#1B1F1C"/>
    <Setter Property="BorderBrush" Value="#CBD3CC"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="MinWidth" Value="90"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SelectionBrush" Value="#66BB6A"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="#2E7D32"/>
              <Setter TargetName="b" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Флажок: зелёный квадрат с белой галкой -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#1B1F1C"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                    BorderBrush="#9AA59C" Background="White" VerticalAlignment="Center">
              <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                    Visibility="Collapsed" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="#2E7D32"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#2E7D32"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="#2E7D32"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Переключатель: зелёная точка -->
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="#1B1F1C"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="ring" Stroke="#9AA59C" StrokeThickness="1.5" Fill="White"/>
              <Ellipse x:Name="dot" Width="8" Height="8" Fill="#2E7D32" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="#2E7D32"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ring" Property="Stroke" Value="#2E7D32"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Группа: белая карточка, зелёный заголовок -->
  <Style TargetType="GroupBox">
    <Setter Property="Margin" Value="0,0,0,10"/>
    <Setter Property="Padding" Value="12,8,12,10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="White" BorderBrush="#DDE3DE" BorderThickness="1" CornerRadius="10">
            <DockPanel>
              <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" Margin="12,8,12,0"
                                TextElement.FontWeight="SemiBold" TextElement.Foreground="#2E7D32"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Слайдер: толстая дорожка, зелёный градиент, круглый ползунок -->
  <Style x:Key="Xyz.SliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="28">
            <Border Height="8" CornerRadius="4" Background="#DDE3DE" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Xyz.SliderFill}" Command="Slider.DecreaseLarge">
                  <RepeatButton.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#1B5E20" Offset="0"/>
                      <GradientStop Color="#81C784" Offset="1"/>
                    </LinearGradientBrush>
                  </RepeatButton.Background>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Xyz.SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Width="22" Height="22">
                        <Ellipse Fill="White" Stroke="#2E7D32" StrokeThickness="3"/>
                        <Ellipse Fill="#2E7D32" Width="7" Height="7"/>
                      </Grid>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Строки списков -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EEF3EF"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="#2E7D32"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#EEF3EF"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="#C8E6C9"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBox">
    <Setter Property="BorderBrush" Value="#DDE3DE"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style TargetType="ListView">
    <Setter Property="BorderBrush" Value="#DDE3DE"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>
